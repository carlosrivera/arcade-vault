{
  "name": "llm-game-vault",
  "version": "1.0.0",
  "description": "A repository and arcade portal for vanilla web games generated with LLMs. Zero build step, runs directly in the browser.",
  "type": "module",
  "imports": {
    "#engine/*": "./shared/engine/*"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "serve": "python3 -m http.server 8137 --bind 127.0.0.1",
    "server": "pnpm --filter @vault/server dev",
    "new-game": "node tools/new-game.js",
    "sync-meta": "node tools/sync-meta.js",
    "meta:check": "node tools/sync-meta.js --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "three": "0.185.1"
  },
  "keywords": [
    "threejs",
    "arcade",
    "games",
    "vanilla-js",
    "retro",
    "llm"
  ],
  "license": "MIT"
}
