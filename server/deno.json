{
  "name": "@vault/server",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-sys --allow-read --env-file=.env src/main.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.13.5",
    "hono/cors": "npm:hono@^4.13.5/cors",
    "ai": "npm:ai@^7.0.84",
    "@openrouter/ai-sdk-provider": "npm:@openrouter/ai-sdk-provider@^3.0.0"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "nodeModulesDir": "auto"
}
