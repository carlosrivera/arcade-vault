# Get a key at https://openrouter.ai/keys — it stays server-side and is never
# sent to the browser.
OPENROUTER_API_KEY=sk-or-v1-...

# Any OpenRouter model slug.
MODEL=anthropic/claude-sonnet-4.5

PORT=8787
# 8137 is what the README documents; 8080 is a common alternative. The panel
# is refused from any origin not listed here.
ALLOWED_ORIGINS=http://localhost:8137,http://127.0.0.1:8137,http://localhost:8080,http://127.0.0.1:8080
